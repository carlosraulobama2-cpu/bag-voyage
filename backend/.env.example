# Variables de entorno del Backend — copia este archivo a .env y completa
# los valores reales. Nunca commitees el .env real (ya está en .gitignore).

PORT=3000

# Conexión a Postgres (Neon u otro proveedor). Formato:
# postgres://usuario:contraseña@host/basededatos?sslmode=require
DATABASE_URL="postgres://usuario:contraseña@host/basededatos?sslmode=require"

# Secreto para firmar los JWT — cambialo en producción, no uses el valor por
# defecto del código (middleware/auth.js y routes/auth.js).
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
